l2cu_instructions_configure () {

	local status=0

	local file_configuration
	local title_configuration
	local count_pieces_configuration
	local category_url_configuration
	local name_url_configuration
	local line

	local -a list_files_configuration=(
		"${directory_model}/title"
		"${directory_model}/pieces"
		"${directory_model%/*}/title"
	)

	frobulator.inf "Configuring instructions" "[ ${name_model} ]"

	frobulator.inf "Validating configuration elements"

	for file_configuration in "${list_files_configuration[@]}"
	do
		if [ ! -f "${file_configuration}" ]
		then
			frobulator.err "Configuration element missing" "[ ${file_configuration} ]"

			status=1
		fi
	done

	if [ "${status}" -ne 0 ]
	then
		return "${status}"
	fi

	frobulator.fwd "Parsing..."

	# title on one line - line breaks removed

	title_configuration="$(< "${directory_model}/title")"
	title_configuration="${title_configuration//$'\n'/ }"
	title_configuration="${title_configuration//<\/br>/}"

	count_pieces_configuration="$(< "${directory_model}/pieces")"

	# category from parent directory title - url form

	category_url_configuration="$(< "${directory_model%/*}/title")"
	category_url_configuration="${category_url_configuration// /-}"

	name_url_configuration="${name_model^^}"

	# substitute configuration variables - write instructions configuration

	while IFS='' read -r line
	do
		line="${line//'${configuration_title_string}'/"${title_configuration}"}"
		line="${line//'${configuration_pieces}'/"${count_pieces_configuration}"}"
		line="${line//'${configuration_url_category}'/"${category_url_configuration}"}"
		line="${line//'${configuration_url_name}'/"${name_url_configuration}"}"

		echo "${line}"
	done < "${directory_instructions_base}/configuration" > "${directory_instructions}/configuration"

	frobulator.track || return "${status}"

	frobulator.fwd "Configuring..."

	# configuration from base instructions framework followed by model

	cat "${directory_instructions}/configuration" "${path_model}" > "${path_model_instructions}"

	frobulator.track

	return "${status}"
}

