l2cu_initialize () {

	local status=0

	# blender conversion script - temporary - removed on exit

	if [ "${option}" = "export" ] && [ "${option_export}" = "blender" ]
	then
		frobulator.temporary directory_temporary

		frobulator.track || return "${status}"

		frobulator.trap "${directory_temporary}"

		file_optimize="${directory_temporary}/optimize.py"

		# python indentation uses spaces - heredoc strips leading tabs only

		cat <<- 'OPTIMIZE' > "${file_optimize}"
		#!/usr/bin/env python3

		import os
		import sys
		import bpy

		# arguments - blender --background --python [script] -- [obj]

		export_model = os.path.abspath(sys.argv[sys.argv.index("--") + 1])

		# prepare scene

		bpy.ops.object.select_all(action = "SELECT")
		bpy.ops.object.delete()

		# import

		bpy.ops.wm.obj_import(filepath = export_model)

		# join objects

		meshes = [obj for obj in bpy.context.scene.objects if obj.type == "MESH"]

		for obj in meshes:
		    obj.select_set(True)

		bpy.context.view_layer.objects.active = meshes[0]
		bpy.ops.object.join()

		# normalize transforms

		bpy.ops.object.transform_apply(
		    location = True,
		    rotation = True,
		    scale = True
		)

		# add smooth shade and edge split modifiers

		bpy.ops.object.shade_smooth()
		bpy.ops.object.modifier_add(
		    type = "EDGE_SPLIT"
		)

		# remove doubles - loose vertices - fix normals

		bpy.ops.object.mode_set(mode = "EDIT")
		bpy.ops.mesh.select_all(action = "SELECT")
		bpy.ops.mesh.remove_doubles()
		bpy.ops.mesh.select_all(action = "DESELECT")
		bpy.ops.mesh.select_loose()
		bpy.ops.mesh.delete(type = "VERT")
		bpy.ops.mesh.select_all(action = "SELECT")
		bpy.ops.mesh.normals_make_consistent(
		    inside = False
		)
		bpy.ops.object.mode_set(mode = "OBJECT")

		# save

		blend_file = os.path.splitext(export_model)[0] + ".blend"
		bpy.ops.wm.save_as_mainfile(
		    filepath = blend_file,
		    compress = True
		)

		print("saved as:", blend_file)
		OPTIMIZE

		frobulator.track
	fi

	# ldraw colors - temporary - removed on exit

	if [ "${option}" = "modify" ]
	then
		frobulator.temporary directory_temporary

		frobulator.track || return "${status}"

