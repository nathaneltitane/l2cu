if [ "${option}" = "instructions" ] && [ -n "${instructions_option}" ]
then
	frobulator.inf "Instructions option" "[ ${instructions_option} ]"
fi

if [ "${option}" = "modify" ]
then
	frobulator.inf "Modify option" "[ ${modify_option} ]"
fi

if [ "${overwrite_option}" = "overwrite" ]
then
	frobulator.wrn "WARNING"

	frobulator.wrn "Overwrite option selected:"
	frobulator.nul "Modifications will be written to model file directly!"
fi

frobulator.countdown 3

frobulator.fwd "Proceeding..."

# export ───────────────────────────────────────────────────────────────────────

if [ "${option}" = "export" ]
then
	for extension in "${extensions_list[@]}"
	do
		mapfile -t models_list < <(find "${directory}" -type f -iname "*.${extension}" ! -iname "*instructions*" | sort)

		for model_path in "${models_list[@]}"
		do
			l2cu_model "${model_path}"

			export_directory="${model_directory}/exports"
			export_file="${model_name}.${export_extension}"

			frobulator.directory "${model_directory}" exports

			cd "${export_directory}"

			frobulator.fail "Export failure" "[ '${model_file}' ]" || continue

			l2cu_export

			frobulator.fail "Export failure" "[ '${model_file}' ]" || continue

			if [ "${export_option}" = "blender" ]
			then
				l2cu_optimize

				frobulator.fail "Optimization failure" "[ '${model_file}' ]" || continue
			fi

			# export size threshold

			l2cu_export_size
		done
	done
fi

# render ───────────────────────────────────────────────────────────────────────

if [ "${option}" = "render" ]
then
	# camera positions / shading / edge width / image size per render option

	height=4096
	width=4096

	case "${render_option}"
	in
		[0-7])
			positions_list=("${render_option}")
			shading="full"
			line_width=1
		;;

		full)
			positions_list=(0 1 2 3 4 5 6 7)
			shading="full"
			line_width=1
		;;

		flat)
			positions_list=(1)
			shading="flat"
			line_width=0
		;;

		wireframe)
			positions_list=(1)
			shading="wireframe"
			line_width=1
		;;

		overlay)
			positions_list=(1)
			shading="full"
			line_width=2
		;;

		social)
			height=600
			width=1200

			positions_list=(1)
			shading="flat"
			line_width=2
		;;

		thumbnail)
			height=512
			width=512

			positions_list=(1)
			shading="flat"
			line_width=2
		;;
	esac

	for extension in "${extensions_list[@]}"
	do
		mapfile -t models_list < <(find "${directory}" -type f -iname "*.${extension}" ! -iname "*instructions*" | sort)

		for model_path in "${models_list[@]}"
		do
			l2cu_model "${model_path}"

			# base render directory - generated if missing

			render_directory="${model_directory}/renders"

			frobulator.directory "${model_directory}" renders

			# named render option directory - purged and regenerated

			if [[ "${render_option}" != [0-7] ]]
			then
				rm --recursive --force "${render_directory}/${render_option}"

				frobulator.directory "${render_directory}" "${render_option}"

				render_directory="${render_directory}/${render_option}"
			fi

			cd "${render_directory}"

			frobulator.fail "Render failure" "[ '${model_file}' ]" || continue

			for coordinates in "${positions_list[@]}"
			do
				l2cu_render "${coordinates}"

				frobulator.fail "Render failure" "[ '${model_file}' // view ${view[coordinates]} ]"
			done

			# single view renders renamed to designated splash images

			case "${render_option}"
			in
				flat|overlay|social|thumbnail)
					if [ -f "${model_name}-${view[1]}.${export_extension}" ]
					then
						mv											\
							"${model_name}-${view[1]}.${export_extension}"	\
							"${render_option}.${export_extension}"
					fi
				;;
			esac
		done
	done
fi

# instructions ─────────────────────────────────────────────────────────────────

if [ "${option}" = "instructions" ]
then
	# instructions configuration required

	if [ ! -f "${instructions_base_directory}/configuration" ]
	then
		frobulator.err "Missing instructions configuration file" "[ ${instructions_base_directory}/configuration ]"

		frobulator.inf "Instructions configuration file required to proceed"

		exit 1
	fi

	for extension in "${extensions_list[@]}"
	do
		mapfile -t models_list < <(find "${directory}" -type f -iname "*.${extension}" ! -iname "*instructions.${extension}" | sort)

		for model_path in "${models_list[@]}"
		do
			l2cu_model "${model_path}"

			instructions_directory="${model_directory}/instructions"
			instructions_samples_directory="${instructions_directory}/samples"
			instructions_model_path="${instructions_directory}/instructions.${extension}"

			# pieces count file - all instructions options

			l2cu_pieces

			frobulator.fail "Pieces failure" "[ '${model_file}' ]" || continue

			if [ "${instructions_option}" = "pieces" ]
			then
				continue
			fi

			l2cu_instructions_prepare

			frobulator.fail "Preparation failure" "[ '${model_file}' ]" || continue

			# model work in progress - placeholder samples

			if [ -f "${model_directory}/work-in-progress" ]
			then
				frobulator.wrn "Model work in progress" "[ ${instructions_option:-instructions} ]"

				l2cu_instructions_samples_placeholders

				frobulator.fail "Placeholders failure" "[ '${model_file}' ]"

				continue
			fi

			l2cu_instructions_configure

			frobulator.fail "Configuration failure" "[ '${model_file}' ]" || continue

			if [ "${instructions_option}" = "samples" ]
			then
				l2cu_instructions_samples

				frobulator.fail "Samples failure" "[ '${model_file}' ]"
			else
				l2cu_instructions

				frobulator.fail "Instructions failure" "[ '${model_file}' ]"
			fi
		done
	done
fi

# modify ───────────────────────────────────────────────────────────────────────

if [ "${option}" = "modify" ]
then
	l2cu_parse_modification

	for extension in "${extensions_list[@]}"
	do
		mapfile -t models_list < <(find "${directory}" -type f -iname "*.${extension}" ! -iname "*modified*" ! -iname "*instructions.${extension}" | sort)

		for model_path in "${models_list[@]}"
		do
			l2cu_model "${model_path}"

			model_buffer="${model_path}.tmp"

			frobulator.stp "Model" "[ ${model_file} ]"

			case "${modify_option}"
			in
				lint)
					l2cu_lint
				;;

				step)
					l2cu_step
				;;

				*)
					l2cu_modify
				;;
			esac

			frobulator.fail "Modification failure" "[ '${model_file}' ]" || continue

			l2cu_write

			frobulator.fail "Write failure" "[ '${model_file}' ]"
		done
	done
fi

# download ─────────────────────────────────────────────────────────────────────

if [ "${option}" = "download" ]
then
	if [ "${download_option}" = "official" ]
	then
		library_release="updates"
		library_archive="complete.zip"
	else
		library_release="unofficial"
		library_archive="ldrawunf.zip"
	fi

	l2cu_download

	frobulator.fail "Download failure" "[ '${library_archive}' ]"
fi

# list ─────────────────────────────────────────────────────────────────────────

if [ "${option}" = "list" ]
then
	# ldraw parts directory verification

	if [ ! -d ldraw ] && [ ! -d LDraw ] && [ ! -d LDRAW ]
	then
		frobulator.err "No LDraw directory found."
	fi

	# parts list backup

	if [ -e parts.lst ]
	then
		frobulator.wrn "Parts list file found."

		frobulator.fwd "Backing up..."

		mv parts.lst parts.lst.bak
	fi

	frobulator.fwd "Processing..."

	l2cu_list &

	frobulator.progress "parse"

	frobulator.fail "List failure" "[ parts.lst ]"

	# sort - merge - cleanup

	for list_file in "._.lst" ".~.lst" parts.lst
	do
		if [ ! -f "${list_file}" ]
		then
			continue
		fi

		if [ "${sort_option}" = "description" ]
		then
			sort -b -d -k 2 -t ' ' -o "${list_file}" "${list_file}"
		fi

		if [ "${sort_option}" = "number" ]
		then
			sort -b -n -k 1 -t ' ' -o "${list_file}" "${list_file}"
		fi
	done

	cat "._.lst" ".~.lst" >> parts.lst 2> "${sink}"

	rm --force "._.lst" ".~.lst"

	# parts list line count

	part_count="$(wc -l < parts.lst)"

	frobulator.inf "Part count" "[ ${part_count} ]"
fi

# complete ─────────────────────────────────────────────────────────────────────

frobulator.result "${script}"
