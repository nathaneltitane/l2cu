   [ "${option}" = "render" ]       ||
   [ "${option}" = "instructions" ] ||
   [ "${option}" = "modify" ]
then
	frobulator.stp "Extension option" "[ ${option_extension} ]"

	frobulator.inf "Option" "[ ${option} ]"
fi

if [ "${option}" = "download" ]
then
	frobulator.inf "Download option" "[ ${option_download} ]"
fi

if [ "${option}" = "list" ]
then
	frobulator.inf "Sort option" "[ ${option_sort} ]"
fi

if [ "${option}" = "export" ]
then
	frobulator.inf "Export option" "[ ${name_export} ]"
fi

if [ "${option}" = "render" ]
then
	frobulator.inf "Render option" "[ ${option_render} ]"
fi

if [ "${option}" = "instructions" ] && [ -n "${option_instructions}" ]
then
	frobulator.inf "Instructions option" "[ ${option_instructions} ]"
fi

if [ "${option}" = "modify" ]
then
	frobulator.inf "Modify option" "[ ${option_modify} ]"
fi

if [ "${option_overwrite}" = "overwrite" ]
then
	frobulator.wrn "WARNING"

	frobulator.wrn "Overwrite option selected:"
	frobulator.nul "Modifications will be written to model file directly!"
fi

frobulator.countdown 3

frobulator.fwd "Proceeding..."

# export ───────────────────────────────────────────────────────────────────────

if [ "${option}" = "export" ]
then
	for extension in "${list_extensions[@]}"
	do
		mapfile -t list_models < <(find "${directory}" -type f -iname "*.${extension}" ! -iname "*instructions*" | sort)

		for path_model in "${list_models[@]}"
		do
			l2cu_model "${path_model}"

			directory_export="${directory_model}/exports"
			file_export="${name_model}.${extension_export}"

			frobulator.directory "${directory_model}" exports

			cd "${directory_export}"

			frobulator.fail "Export failure" "[ '${file_model}' ]" || continue

			l2cu_export

			frobulator.fail "Export failure" "[ '${file_model}' ]" || continue

			if [ "${option_export}" = "blender" ]
			then
				l2cu_optimize

				frobulator.fail "Optimization failure" "[ '${file_model}' ]" || continue
			fi

			# export size threshold

			l2cu_export_size
		done
	done
fi

# render ───────────────────────────────────────────────────────────────────────

if [ "${option}" = "render" ]
then
	# camera positions / shading / edge width / image size per render option

	height_render=4096
	width_render=4096

	case "${option_render}"
	in
		[0-7])
			list_positions=("${option_render}")
			shading="full"
			width_line=1
		;;

		full)
			list_positions=(0 1 2 3 4 5 6 7)
			shading="full"
			width_line=1
		;;

		flat)
			list_positions=(1)
			shading="flat"
			width_line=0
		;;

		wireframe)
			list_positions=(1)
			shading="wireframe"
			width_line=1
		;;

		overlay)
			list_positions=(1)
			shading="full"
			width_line=2
		;;

		social)
			height_render=600
			width_render=1200

			list_positions=(1)
			shading="flat"
			width_line=2
		;;

		thumbnail)
			height_render=512
			width_render=512

			list_positions=(1)
			shading="flat"
			width_line=2
		;;
	esac

	for extension in "${list_extensions[@]}"
	do
		mapfile -t list_models < <(find "${directory}" -type f -iname "*.${extension}" ! -iname "*instructions*" | sort)

		for path_model in "${list_models[@]}"
		do
			l2cu_model "${path_model}"

			# base render directory - generated if missing

			directory_render="${directory_model}/renders"

			frobulator.directory "${directory_model}" renders

			# named render option directory - purged and regenerated

			if [[ "${option_render}" != [0-7] ]]
			then
				rm --recursive --force "${directory_render}/${option_render}"

				frobulator.directory "${directory_render}" "${option_render}"

				directory_render="${directory_render}/${option_render}"
			fi

			cd "${directory_render}"

			frobulator.fail "Render failure" "[ '${file_model}' ]" || continue

			for index_view in "${list_positions[@]}"
			do
				l2cu_render "${index_view}"

				frobulator.fail "Render failure" "[ '${file_model}' // view ${list_views[index_view]} ]"
			done

			# single view renders renamed to designated splash images

			case "${option_render}"
			in
				flat|overlay|social|thumbnail)
					if [ -f "${name_model}-${list_views[1]}.${extension_export}" ]
					then
						mv											\
							"${name_model}-${list_views[1]}.${extension_export}"	\
							"${option_render}.${extension_export}"
					fi
				;;
			esac
		done
	done
fi

# instructions ─────────────────────────────────────────────────────────────────

if [ "${option}" = "instructions" ]
then
	# instructions configuration required

	if [ ! -f "${directory_instructions_base}/configuration" ]
	then
		frobulator.err "Missing instructions configuration file" "[ ${directory_instructions_base}/configuration ]"

		frobulator.inf "Instructions configuration file required to proceed"

		exit 1
	fi

	for extension in "${list_extensions[@]}"
	do
		mapfile -t list_models < <(find "${directory}" -type f -iname "*.${extension}" ! -iname "*instructions.${extension}" | sort)

		for path_model in "${list_models[@]}"
		do
			l2cu_model "${path_model}"

			directory_instructions="${directory_model}/instructions"
			directory_samples_instructions="${directory_instructions}/samples"
			path_model_instructions="${directory_instructions}/instructions.${extension}"

			# pieces count file - all instructions options

			l2cu_pieces

			frobulator.fail "Pieces failure" "[ '${file_model}' ]" || continue

			if [ "${option_instructions}" = "pieces" ]
			then
				continue
			fi

			l2cu_instructions_prepare

			frobulator.fail "Preparation failure" "[ '${file_model}' ]" || continue

			# model work in progress - placeholder samples

			if [ -f "${directory_model}/work-in-progress" ]
			then
				frobulator.wrn "Model work in progress" "[ ${option_instructions:-instructions} ]"

				l2cu_instructions_samples_placeholders

				frobulator.fail "Placeholders failure" "[ '${file_model}' ]"

				continue
			fi

			l2cu_instructions_configure

			frobulator.fail "Configuration failure" "[ '${file_model}' ]" || continue

			if [ "${option_instructions}" = "samples" ]
			then
				l2cu_instructions_samples

				frobulator.fail "Samples failure" "[ '${file_model}' ]"
			else
				l2cu_instructions

				frobulator.fail "Instructions failure" "[ '${file_model}' ]"
			fi
		done
	done
fi

# modify ───────────────────────────────────────────────────────────────────────

if [ "${option}" = "modify" ]
then
	l2cu_parse_modification

	for extension in "${list_extensions[@]}"
	do
		mapfile -t list_models < <(find "${directory}" -type f -iname "*.${extension}" ! -iname "*modified*" ! -iname "*instructions.${extension}" | sort)

		for path_model in "${list_models[@]}"
		do
			l2cu_model "${path_model}"

			file_buffer_model="${path_model}.tmp"

			frobulator.stp "Model" "[ ${file_model} ]"

			case "${option_modify}"
			in
				lint)
					l2cu_lint
				;;

				step)
					l2cu_step
				;;

				*)
					l2cu_modify
				;;
			esac

			frobulator.fail "Modification failure" "[ '${file_model}' ]" || continue

			l2cu_write

			frobulator.fail "Write failure" "[ '${file_model}' ]"
		done
	done
fi

# download ─────────────────────────────────────────────────────────────────────

if [ "${option}" = "download" ]
then
	if [ "${option_download}" = "official" ]
	then
		path_release_library="updates"
		file_archive_library="complete.zip"
	else
		path_release_library="unofficial"
		file_archive_library="ldrawunf.zip"
	fi

	l2cu_download

	frobulator.fail "Download failure" "[ '${file_archive_library}' ]"
fi

# list ─────────────────────────────────────────────────────────────────────────

if [ "${option}" = "list" ]
then
	# ldraw parts directory verification

	if [ ! -d ldraw ] && [ ! -d LDraw ] && [ ! -d LDRAW ]
	then
		frobulator.err "No LDraw directory found."
	fi

	# parts list backup

	if [ -e parts.lst ]
	then
		frobulator.wrn "Parts list file found."

		frobulator.fwd "Backing up..."

		mv parts.lst parts.lst.bak
	fi

	frobulator.fwd "Processing..."

	l2cu_list &

	frobulator.progress "parse"

	frobulator.fail "List failure" "[ parts.lst ]"

	# sort - merge - cleanup

	for file_list in "._.lst" ".~.lst" parts.lst
	do
		if [ ! -f "${file_list}" ]
		then
			continue
		fi

		if [ "${option_sort}" = "description" ]
		then
			sort -b -d -k 2 -t ' ' -o "${file_list}" "${file_list}"
		fi

		if [ "${option_sort}" = "number" ]
		then
			sort -b -n -k 1 -t ' ' -o "${file_list}" "${file_list}"
		fi
	done

	cat "._.lst" ".~.lst" >> parts.lst 2> "${sink}"

	rm --force "._.lst" ".~.lst"

	# parts list line count

	count_parts_list="$(wc -l < parts.lst)"

	frobulator.inf "Part count" "[ ${count_parts_list} ]"
fi

# complete ─────────────────────────────────────────────────────────────────────

frobulator.result "${script}"
