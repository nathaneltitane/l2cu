l2cu_parse_input () {

	# read user input - empty input refused

	local status=0

	while true
	do
		frobulator.read input

		if [ -n "${input}" ]
		then
			break
		fi

		frobulator.ipt "Input cannot be empty - Try again."
	done

	return "${status}"
}

l2cu_help_colors () {

	local status=0

	frobulator.fwd "Displaying official colors selections..."

	frobulator.timeout

	frobulator.inf "Official LDraw colors" "[ name / number / hexadecimal ]"

	sed -e "s/^/${marker_idt}/g" -e "s/_/ /g" "${file_colors}"

	echo

	return "${status}"
}

l2cu_parse_colors () {

	# match input to an ldraw color - name / number / hexadecimal - lowercase

	local status=0

	local input_color
	local name_color
	local value_color
	local hex_color

	l2cu_parse_input

	input_color="${input,,}"
	input_color="${input_color#\#}"

	while read -r name_color value_color hex_color
	do
		name_color="${name_color//_/ }"
		hex_color="${hex_color#\#}"

		if [ "${input_color}" = "${name_color,,}" ] ||
		   [ "${input_color}" = "${value_color}" ] ||
		   [ "${input_color}" = "${hex_color,,}" ]
		then
			value_color_ldraw="${value_color}"

			frobulator.fwd "Confirming input..."

			frobulator.timeout

			frobulator.inf "Color name"              "[ ${name_color} ]"
			frobulator.inf "Color value"             "[ ${value_color} ]"
			frobulator.inf "Color hexadecimal value" "[ ${hex_color} ]"

			return "${status}"
		fi
	done < "${file_colors}"

	frobulator.err "No match for input" "[ ${input} ]"

	frobulator.timeout

	l2cu_help_colors

	frobulator.fwd "Exiting..."

	exit 1
}

l2cu_parse_modification () {

	# read modification request

	local status=0

	case "${option_modify}"
	in
		color)
			frobulator.ipt "Enter color to modify" "[ name / number / hexadecimal ]"

			l2cu_parse_colors

			value_color_old="${value_color_ldraw}"

			frobulator.ipt "Enter color to set" "[ name / number / hexadecimal ]"

			l2cu_parse_colors

			value_color_new="${value_color_ldraw}"
		;;

		part)
			frobulator.ipt "Enter part to modify" "[ number ]"

			l2cu_parse_input

			number_part_old="${input}"

			frobulator.ipt "Enter part to set" "[ number ]"

			l2cu_parse_input

			number_part_new="${input}"
		;;

		bind)
			frobulator.ipt "Enter part to modify" "[ number ]"

			l2cu_parse_input

			number_part_selection="${input}"

			frobulator.ipt "Enter part color to modify" "[ name / number / hexadecimal ]"

			l2cu_parse_colors

			value_color_old="${value_color_ldraw}"

			frobulator.ipt "Enter part color to set" "[ name / number / hexadecimal ]"

			l2cu_parse_colors

			value_color_new="${value_color_ldraw}"
		;;
	esac

	return "${status}"
}

l2cu_lint () {

	# standardize model file for parsing

	local status=0

	frobulator.fwd "Linting..."

	# substitute windows carriage return for unix newline
	# strip ' . . .' tails left by earlier l2cu versions
	# substitute lines containing empty parsing string
	# substitute multiple whitespace characters to single whitespace
	# substitute author tag to uppercase author tag

	# delete lines containing name meta
	# delete lines with lone line type
	# delete lines beginning with whitespace character
	# delete lines beginning with dot character
	# delete lines containing BACKGROUND meta
	# delete lines containing PIVOT meta
	# delete lines containing HIDDEN meta

	# strip '(' character from model entries
	# strip ')' character from model entries

	# delete empty lines

	sed										\
		-e 's/\r//g' 						\
		-e 's/\( \{1,\}\.\)\{1,\} *$//'		\
		-e 's/0 STEP .* *\./0 STEP/g'		\
		-e 's/  */ /g'						\
		-e 's/Author/AUTHOR/g'				\
		-e '/Name/d'						\
		-e '/^0 *$/d'						\
		-e '/^1\ $/d'						\
		-e '/^ /d'							\
		-e '/^\./d'							\
		-e '/BACKGROUND/d'					\
		-e '/PIVOT/d'						\
		-e '/HIDDEN/d'						\
		-e 's/(//g'							\
		-e 's/)//g'							\
		-e '/^$/d'							\
											"${path_model}" > "${file_buffer_model}"

	frobulator.track

	return "${status}"
}

l2cu_line_repair () {

	# ' . . .' tails left on meta lines by earlier l2cu versions removed
	# works on the caller's line - counted in the caller's count_lines_repaired

	local status=0
	local pattern_tail='^(0.*[^ ])( +\.)+ *$'

	local line_inner

	if [[ "${line}" != 0* ]]
	then
		return "${status}"
	fi

	line_inner="${line#*$'\r'}"

	if [ "${line_inner}" != "${line}" ] && [[ "${line_inner}" =~ ^[\ .]*$ ]]
	then
		line="${line%%$'\r'*}"

		count_lines_repaired=$(( count_lines_repaired + 1 ))

	elif [[ "${line}" =~ ${pattern_tail} ]]
	then
		line="${BASH_REMATCH[1]}"

		count_lines_repaired=$(( count_lines_repaired + 1 ))
	fi

	return "${status}"
}

l2cu_modify () {

	# modify part references - other lines kept as is
	# line ending set aside before parsing - fields never carry it

	local status=0
	local count_lines_repaired=0

	local line
	local ending_line
	local state_line_modified
	local type_line
	local color
	local x
	local y
	local z
	local a
	local b
	local c
	local d
	local e
	local f
	local g
	local h
	local i
	local component
	local part

	: > "${file_buffer_model}"

	frobulator.track || return "${status}"

	# last line kept if it has no trailing newline

	while IFS='' read -r line || [ -n "${line}" ]
	do
		unset ending_line

		if [[ "${line}" = *$'\r' ]]
		then
			ending_line=$'\r'
			line="${line%$'\r'}"
		fi

		l2cu_line_repair

		read -r type_line color x y z a b c d e f g h i component <<< "${line}"

		# part / submodel references only - line type 1 with all fields

		if [ "${type_line}" != "1" ] || [ -z "${component}" ]
		then
			printf '%s%s\n' "${line}" "${ending_line}" >> "${file_buffer_model}"

			continue
		fi

		# component is either part or submodel - [number].dat / [name].ldr

		part="${component%.*}"

		unset state_line_modified

		case "${option_modify}"
		in
			color)
				if [ "${color}" = "${value_color_old}" ]
				then
					color="${value_color_new}"
					state_line_modified=true

					frobulator.inf "Modifying" "[ ${value_color_old} ]"
					frobulator.inf "Setting"   "[ ${value_color_new} ]"
				fi
			;;

			part)
				if [ "${part}" = "${number_part_old}" ]
				then
					component="${number_part_new}.${component##*.}"
					state_line_modified=true

					frobulator.inf "Modifying" "[ ${number_part_old} ]"
					frobulator.inf "Setting"   "[ ${number_part_new} ]"
				fi
			;;

			bind)
				if [ "${part}" = "${number_part_selection}" ] && [ "${color}" = "${value_color_old}" ]
				then
					color="${value_color_new}"
					state_line_modified=true

					frobulator.inf "Part"      "[ ${part} ]"

					frobulator.inf "Modifying" "[ ${value_color_old} ]"
					frobulator.inf "Setting"   "[ ${value_color_new} ]"
				fi
			;;
		esac

		if [ "${state_line_modified}" != "true" ]
		then
			printf '%s%s\n' "${line}" "${ending_line}" >> "${file_buffer_model}"

			continue
		fi

		# rebuilt line shares the original line ending

		printf '%s%s\n' "${type_line} ${color} ${x} ${y} ${z} ${a} ${b} ${c} ${d} ${e} ${f} ${g} ${h} ${i} ${component}" "${ending_line}" >> "${file_buffer_model}"
	done < "${path_model}"

	frobulator.track

	if [ "${count_lines_repaired}" -gt 0 ]
	then
		frobulator.inf "Repaired meta lines" "[ ${count_lines_repaired} ]"
	fi

	return "${status}"
}

l2cu_step () {

	# each ldr submodel in its own step - a step is closed only if it holds parts
	# piece meta lines kept with their piece - empty steps removed
	# line ending set aside before parsing - fields never carry it

	local status=0
	local count_lines_repaired=0
	local count_steps_removed=0
	local state_step_parts=false

	local line
	local ending_line
	local line_pending
	local state_step_added
	local type_line
	local color
	local x
	local y
	local z
	local a
	local b
	local c
	local d
	local e
	local f
	local g
	local h
	local i
	local component

	local -a list_lines_pending=()

	: > "${file_buffer_model}"

	frobulator.track || return "${status}"

	# last line kept if it has no trailing newline

	while IFS='' read -r line || [ -n "${line}" ]
	do
		unset ending_line

		if [[ "${line}" = *$'\r' ]]
		then
			ending_line=$'\r'
			line="${line%$'\r'}"
		fi

		l2cu_line_repair

		# piece meta lines held until their piece

		if [[ "${line}" = "0 !LEOCAD PIECE "* ]]
		then
			list_lines_pending+=("${line}${ending_line}")

			continue
		fi

		# step closed only if it holds parts - step following an added step not counted

		if [ "${line}" = "0 STEP" ]
		then
			if [ "${state_step_parts}" = "true" ]
			then
				printf '%s%s\n' "${line}" "${ending_line}" >> "${file_buffer_model}"

				state_step_parts=false

			elif [ "${state_step_added}" != "true" ]
			then
				count_steps_removed=$(( count_steps_removed + 1 ))
			fi

			unset state_step_added

			continue
		fi

		unset state_step_added

		read -r type_line color x y z a b c d e f g h i component <<< "${line}"

		# ldr submodel - previous step closed - own step

		if [ "${type_line}" = "1" ] && [[ "${component}" = *.[lL][dD][rR] ]]
		then
			if [ "${state_step_parts}" = "true" ]
			then
				printf '%s%s\n' "0 STEP" "${ending_line}" >> "${file_buffer_model}"
			fi

			for line_pending in "${list_lines_pending[@]}"
			do
				printf '%s\n' "${line_pending}" >> "${file_buffer_model}"
			done

			list_lines_pending=()

			# submodel color reset - applications use incompatible color schemes

			printf '%s%s\n' "${type_line} 0 ${x} ${y} ${z} ${a} ${b} ${c} ${d} ${e} ${f} ${g} ${h} ${i} ${component}" "${ending_line}" >> "${file_buffer_model}"
			printf '%s%s\n' "0 STEP" "${ending_line}" >> "${file_buffer_model}"

			state_step_parts=false
			state_step_added=true

			frobulator.inf "Stepping" "[ ${component} ]"

			continue
		fi

		for line_pending in "${list_lines_pending[@]}"
		do
			printf '%s\n' "${line_pending}" >> "${file_buffer_model}"
		done

		list_lines_pending=()

		printf '%s%s\n' "${line}" "${ending_line}" >> "${file_buffer_model}"

		# drawing lines fill the step - a new submodel starts empty

		case "${type_line}"
		in
			1|2|3|4|5)
				state_step_parts=true
			;;
		esac

		if [[ "${line}" = "0 FILE "* ]]
		then
			state_step_parts=false
		fi
	done < "${path_model}"

	frobulator.track

	for line_pending in "${list_lines_pending[@]}"
	do
		printf '%s\n' "${line_pending}" >> "${file_buffer_model}"
	done

	if [ "${count_lines_repaired}" -gt 0 ]
	then
		frobulator.inf "Repaired meta lines" "[ ${count_lines_repaired} ]"
	fi

	if [ "${count_steps_removed}" -gt 0 ]
	then
		frobulator.inf "Removed empty steps" "[ ${count_steps_removed} ]"
	fi

	return "${status}"
}

l2cu_write () {

	# modified model file - original overwritten or timestamped copy

	local status=0
	local file_copy_model="${directory_model}/${name_model}-modified-${stamp}.${extension}"

	if [ "${option_overwrite}" = "overwrite" ]
	then
		frobulator.wrn "Writing to model file original" "[ ${file_model} ]"

		frobulator.timeout

		mv "${file_buffer_model}" "${path_model}"
	else
		frobulator.wrn "Writing to model file copy" "[ ${file_copy_model##*/} ]"

		frobulator.fwd "Writing..."

		mv "${file_buffer_model}" "${file_copy_model}"
	fi

	frobulator.track

	return "${status}"
}

l2cu_download () {

	# ldraw parts library archive

	local status=0

	frobulator.download "${url_library}/${path_release_library}" "${directory}" "${file_archive_library}"

	frobulator.track || return "${status}"

	# leocad reads the parts archive without extraction - official archive renamed

	if [ "${option_download}" = "official" ]
	then
		mv 											\
			"${directory}/${file_archive_library}"		\
			"${directory}/ldraw.zip"

		frobulator.track
	fi

	return "${status}"
}

l2cu_list () {

	# ldraw parts list entries - moved parts skipped - '_' and '~' descriptions listed last

	local status=0

	local extension
	local path_part
	local file_part
	local line_header_part
	local description_part

	local -a list_parts=()

	for extension in "${list_extensions[@]}"
	do
		mapfile -t list_parts < <(find "${directory}" -type f -iname "*.${extension}")

		for path_part in "${list_parts[@]}"
		do
			file_part="${path_part##*/}"

			read -r line_header_part < "${path_part}"

			description_part="${line_header_part:2}"
			description_part="${description_part%$'\r'}"

			if [[ "${description_part}" == *~Moved* ]]
			then
				continue
			fi

			if [[ "${description_part}" == *_* ]]
			then
				printf '%-30s %-s\n' "${file_part}" "${description_part}" >> "._.lst"

			elif [[ "${description_part}" == *~* ]]
			then
				printf '%-30s %-s\n' "${file_part}" "${description_part}" >> ".~.lst"
			else
				printf '%-30s %-s\n' "${file_part}" "${description_part}" >> parts.lst
			fi
		done
	done

	return "${status}"
}

