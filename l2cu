then
	lpub="lpub3d"
else
	lpub="lpub3d24"
fi

# defaults ─────────────────────────────────────────────────────────────────────

if [ -z "${directory}" ]
then
	frobulator.qst "Specify directory?"

	frobulator.read reply

	if [[ "${reply}" = [yY] || "${reply}" = [yY][eE][sS] ]]
	then
		# specify directory location or exit on 'cancel'

		directory="$(frobulator.dialog "Directory")"
	else
		frobulator.err "No directory specified."

		frobulator.fwd "Assuming defaults..."

		directory="${PWD}"
	fi
fi

if [ -z "${extension_option}" ]
then
	frobulator.qst "Specify model file type? [ simple / multipart ]"

	frobulator.read reply

	if [[ "${reply}" = [yY] || "${reply}" = [yY][eE][sS] ]]
	then
		frobulator.ipt "Specify model file extension [ all / dat / ldr / mpd ]"

		while true
		do
			frobulator.read extension_option

			if [[ "${extension_option}" =~ ^(all|dat|ldr|mpd)$ ]]
			then
				break
			fi

			frobulator.wrn "Unrecognized model file extension."
			frobulator.wrn "Try again."
		done

		if [ "${extension_option}" = "all" ]
		then
			extensions_list=(
				dat
				ldr
				mpd
			)
		else
			extensions_list=(
				"${extension_option}"
			)
		fi
	else
		# default - multipart model files

		frobulator.err "No file type specified."

		frobulator.fwd "Assuming defaults..."

		extension_option="mpd"

		extensions_list=(
			mpd
		)
	fi
fi

if [ "${option}" = "export" ] && [ -z "${export_option}" ]
then
	export_option="collada"
	export_extension="dae"
	export_name="Collada"
fi

if [ "${option}" = "render" ]
then
	export_extension="png"
fi

if [ "${option}" = "instructions" ]
then
	if [ "${instructions_option}" = "samples" ]
	then
		export_extension="png"
	else
		export_extension="pdf"
	fi
fi

if [ -z "${render_option}" ]
then
	render_option="full"
fi

if [ -z "${modify_option}" ]
then
	modify_option="color"
fi

if [ -z "${download_option}" ]
then
	download_option="official"
fi

if [ -z "${sort_option}" ]
then
	sort_option="description"
fi

