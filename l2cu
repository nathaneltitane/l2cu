#!/bin/bash

# dependencies ─────────────────────────────────────────────────────────────────

script="$(basename -- "${BASH_SOURCE[0]}")"

# script arguments for escalation

self_arguments=("${@}")

if [ "${frobulator_loaded}" != "true" ]
then
	echo
	echo "[  >  ] Checking..."
	echo

	# root through sudo keeps using the user's frobulator

	if [ -n "${SUDO_USER}" ]
	then
		USER="${SUDO_USER}"
		HOME="$(getent passwd "${SUDO_USER}" | cut -d ':' -f 6)"
	fi

	frobulator="${HOME}/.local/bin/frobulator"
	frobulator_download="$(mktemp)"

	mkdir -p "${HOME}/.local/bin"

	# latest release - curl or wget - local copy replaced only by a newer one

	curl -s -L -o "${frobulator_download}" get.frbltr.app 2> /dev/null ||
	wget -q -O "${frobulator_download}" get.frbltr.app 2> /dev/null

	version_online="$(grep -m 1 '^update=' "${frobulator_download}")"
	version_local="$(grep -m 1 '^update=' "${frobulator}" 2> /dev/null)"

	if [[ "${version_online}" > "${version_local}" ]]
	then
		mv -f "${frobulator_download}" "${frobulator}"

		chmod +x "${frobulator}"
	fi

	rm -f "${frobulator_download}"

	if [ ! -f "${frobulator}" ]
	then
		echo "[  !  ] Unable to fetch frobulator ── [ get.frbltr.app ]"
		echo

		exit 1
	fi

	source "${frobulator}"
fi

# superuser ────────────────────────────────────────────────────────────────────

frobulator.escalate

# script ───────────────────────────────────────────────────────────────────────

frobulator.script

# version ──────────────────────────────────────────────────────────────────────

version="2026-10-06"

# usage ────────────────────────────────────────────────────────────────────────

while (( $# ))
do
	case "${1}"
	in
		-d|--directory)
			directory="${2}"

			shift
		;;

		-f|--file)
			# model file extension follows as parameter

			:
		;;

			all)
				option_extension="all"

				list_extensions=(
					dat
					ldr
					mpd
				)
			;;

			dat|ldr|mpd)
				option_extension="${1}"

				list_extensions=(
					"${1}"
				)
			;;

		-e|--export)
			option="export"
		;;

			csv)
				option_export="csv"
				extension_export="csv"
				name_export="Comma Separated Values"
			;;

			3dstudio)
				option_export="3dstudio"
				extension_export="3ds"
				name_export="3DS"
			;;

			collada)
				option_export="collada"
				extension_export="dae"
				name_export="Collada"
			;;

			blender)
				# exported as obj - optimized into blend

				option_export="blender"
				extension_export="obj"
				name_export="Blender"
			;;

			wavefront)
				option_export="wavefront"
				extension_export="obj"
				name_export="Wavefront"
			;;

		-r|--render)
			option="render"
		;;

			full|flat|wireframe|overlay|social|thumbnail|[0-7])
				option_render="${1}"
			;;

		-i|--instructions)
			option="instructions"
		;;

			pieces|samples)
				option_instructions="${1}"
			;;

		-m|--modify)
			option="modify"
		;;

			color|part|bind|lint|step)
				option_modify="${1}"
			;;

		-o|--overwrite)
			option_overwrite="overwrite"
		;;

		-w|--download)
			option="download"
		;;

			official|unofficial)
				option_download="${1}"
			;;

		-l|--list)
			option="list"
			option_extension="dat"

			list_extensions=(
				dat
			)
		;;

			description|number)
				option_sort="${1}"
			;;

		-h|--help)
			echo
			echo -e "Usage: ./${script} [EXTENSION] | [OPTION] [PARAMETER]"
			echo
			echo -e "Options:"
			echo
			echo -e "-d, --directory       Specify [d]irectory to load models from."
			echo
			echo -e "-f, --file            Specify model [f]ile extension to work on."
			echo
			echo -e "                      all    Select dat / ldr / mpd file formats as target."
			echo -e "                      dat    Select dat file format as target."
			echo -e "                      ldr    Select ldr file format as target."
			echo -e "                      mpd    Select mpd file format as target. [ Default ]"
			echo
			echo -e "-e, --export          Run model file [e]xport using the following parameters:"
			echo
			echo -e "                      csv          Export parts list file format. [ csv ]"
			echo -e "                      3dstudio     Export 3dstudio file format. [ 3ds ]"
			echo -e "                      collada      Export collada file format. [ dae ] [ Default ]"
			echo -e "                      blender      Optimize wavefront and export to blender file format. [ obj >>> blend ]"
			echo -e "                      wavefront    Export wavefront file format. [ obj + mtl ]"
			echo
			echo -e "-r, --render          Run model file [r]endering using the following parameters:"
			echo
			echo -e "                      full         Render series of images using view presets 0 to 7. [ Default ]"
			echo -e "                      flat         Render image using view preset 1 without edges or shading."
			echo -e "                      wireframe    Render image using view preset 1 without faces or shading."
			echo -e "                      overlay      Render image using view preset 1 with heavy edges."
			echo -e "                      social       Render image using view preset 1 with edges at 1200 x 600 pixels."
			echo -e "                      thumbnail    Render image using view preset 1 with edges at 512 x 512 pixels."
			echo
			echo -e "                      0            Render image using view preset 0. [ latitude // 30 ] [ longitude // 0 ]"
			echo -e "                      1            Render image using view preset 1. [ latitude // 30 ] [ longitude // 45 ]"
			echo -e "                      2            Render image using view preset 2. [ latitude // 30 ] [ longitude // 90 ]"
			echo -e "                      3            Render image using view preset 3. [ latitude // 30 ] [ longitude // 135 ]"
			echo -e "                      4            Render image using view preset 4. [ latitude // 30 ] [ longitude // 180 ]"
			echo -e "                      5            Render image using view preset 5. [ latitude // 30 ] [ longitude // 225 ]"
			echo -e "                      6            Render image using view preset 6. [ latitude // 30 ] [ longitude // 270 ]"
			echo -e "                      7            Render image using view preset 7. [ latitude // 30 ] [ longitude // 315 ]"
			echo
			echo -e "-i, --instructions    Generate model [i]nstruction file."
			echo
			echo -e "                      [ pdf ]"
			echo
			echo -e "                      pieces     Display and generate pieces count file."
			echo -e "                      samples    Generate instructions sample preview files. [ png ] [ count // 6 ]"
			echo
			echo -e "-m, --modify          Run model file [m]odification using the following parameters:"
			echo
			echo -e "                      lint     Standardize and format model files for parsing."
			echo -e "                      color    Modify a part's color attribute only. [ Default ]"
			echo -e "                      part     Modify a part for another by number attribute only."
			echo -e "                      bind     Match a part to a specific color and modify the color for that selection."
			echo -e "                      step     Separate ldr based submodels using step meta tags."
			echo
			echo -e "-o, --overwrite       Write modifications to the [o]riginal model file."
			echo
			echo -e "-w, --download        Run do[w]nload of the LDraw parts library."
			echo
			echo -e "                      official      Download the complete official LDraw parts library archive. [ Default ]"
			echo -e "                      unofficial    Download the complete unofficial LDraw parts library archive."
			echo
			echo -e "-l, --list            Generate the LDraw parts [l]ist for use with legacy editors."
			echo
			echo -e "                      description    Sort list by part description. [ Default ]"
			echo -e "                      number         Sort list by part number."
			echo
			echo -e "-h, --help            Show [h]elp and usage information."
			echo
			echo -e "'${script}'           [ Version // ${version} ]"
			echo

			exit
		;;

		"")
			# handle empty argument:
			# use default values specified in script

			:
		;;

		*)
			echo
			echo -e "Usage: ./${script} [EXTENSION] | [OPTION] [PARAMETER]"
			echo
			echo -e "Unknown option: '${script} ${1}':"
			echo -e "Type './${script} -h' for help and usage information."
			echo

			exit 1

		;;

		esac

	shift

done

