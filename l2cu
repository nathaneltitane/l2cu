# defaults ─────────────────────────────────────────────────────────────────────

if [ -z "${directory}" ]
then
	frobulator.qst "Specify directory?"

	frobulator.read reply

	if [[ "${reply}" = [yY] || "${reply}" = [yY][eE][sS] ]]
	then
		# specify directory location or exit on 'cancel'

		directory="$(frobulator.dialog "Directory")"
	else
		frobulator.err "No directory specified."

		frobulator.fwd "Assuming defaults..."

		directory="${PWD}"
	fi
fi

if [ -z "${option_extension}" ]
then
	frobulator.qst "Specify model file type? [ simple / multipart ]"

	frobulator.read reply

	if [[ "${reply}" = [yY] || "${reply}" = [yY][eE][sS] ]]
	then
		frobulator.ipt "Specify model file extension [ all / dat / ldr / mpd ]"

		while true
		do
			frobulator.read option_extension

			if [[ "${option_extension}" =~ ^(all|dat|ldr|mpd)$ ]]
			then
				break
			fi

			frobulator.wrn "Unrecognized model file extension."
			frobulator.wrn "Try again."
		done

		if [ "${option_extension}" = "all" ]
		then
			list_extensions=(
				dat
				ldr
				mpd
			)
		else
			list_extensions=(
				"${option_extension}"
			)
		fi
	else
		# default - multipart model files

		frobulator.err "No file type specified."

		frobulator.fwd "Assuming defaults..."

		option_extension="mpd"

		list_extensions=(
			mpd
		)
	fi
fi

if [ "${option}" = "export" ] && [ -z "${option_export}" ]
then
	option_export="collada"
	extension_export="dae"
	name_export="Collada"
fi

if [ "${option}" = "render" ]
then
	extension_export="png"
fi

if [ "${option}" = "instructions" ]
then
	if [ "${option_instructions}" = "samples" ]
	then
		extension_export="png"
	else
		extension_export="pdf"
	fi
fi

if [ -z "${option_render}" ]
then
	option_render="full"
fi

if [ -z "${option_modify}" ]
then
	option_modify="color"
fi

if [ -z "${option_download}" ]
then
	option_download="official"
fi

if [ -z "${option_sort}" ]
then
	option_sort="description"
fi

