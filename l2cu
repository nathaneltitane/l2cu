l2cu_instructions_samples () {

	local status=0
	local renderer="native"
	local projection="perspective"
	local number_sample=1

	local count_step
	local index_sample
	local range_sample
	local path_sample

	local -a list_pages_sample=()
	local -a list_samples=()

	frobulator.inf "Generating instructions" "[ ${name_model} ]"

	# step count of the instructions model

	count_step="$(grep -c -E '^0 STEP' "${path_model_instructions}")"

	# six sample pages spread over the instructions - first page minimum

	list_pages_sample=(
		1
		$(( count_step / 5 - 2 ))
		$(( count_step / 4 - 3 ))
		$(( count_step / 3 - 4 ))
		$(( count_step / 2 - 5 ))
		"${count_step}"
	)

	for index_sample in "${!list_pages_sample[@]}"
	do
		if [ "${list_pages_sample[index_sample]}" -lt 1 ]
		then
			list_pages_sample[index_sample]=1
		fi
	done

	printf -v range_sample '%s,' "${list_pages_sample[@]}"

	range_sample="${range_sample%,}"

	frobulator.stp "Generating range" "[ ${range_sample} ]"

	"${command_lpub}"											\
		--clear-cache									\
		--preferred-renderer	"${renderer}"			\
		--projection			"${projection}"			\
		--process-export								\
		--export-option			"${extension_export}"	\
		--range					"${range_sample}"		\
														"${path_model_instructions}" > "${sink}" 2>&1 &

	frobulator.progress "generate"

	frobulator.track

	l2cu_instructions_clean

	# sample pages renamed in page order

	mapfile -t list_samples < <(find "${directory_instructions}" -type f -iname "*page*.${extension_export}" | sort -V)

	for path_sample in "${list_samples[@]}"
	do
		mv "${path_sample}" "${directory_samples_instructions}/sample-0${number_sample}.${extension_export}"

		frobulator.track

		number_sample=$(( number_sample + 1 ))
	done

	return "${status}"
}

