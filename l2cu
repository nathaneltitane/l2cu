l2cu_model () {

	# model path elements - shared by all options

	local status=0

	path_model="${1}"
	file_model="${path_model##*/}"
	name_model="${file_model%.*}"
	directory_model="${path_model%/*}"

	return "${status}"
}

l2cu_export () {

	local status=0

	frobulator.inf "Exporting" "[ ${file_model} ]"

	frobulator.fwd "Output" "[ ${name_export} // ${file_export} ]"

	leocad											\
		-"${extension_export}"	"${file_export}" 	\
													"${path_model}" > "${sink}" 2>&1 &

	frobulator.progress "generate"

	frobulator.track || return "${status}"

	# collada transparency read as opaque by viewers

	if [ "${option_export}" = "collada" ]
	then
		sed																\
			-i															\
			-e		's/<transparent>/<transparent opaque="A_ONE">/g'	\
																		"${file_export}"

		frobulator.track
	fi

	return "${status}"
}

l2cu_optimize () {

	# import obj into blender - save optimized blend - obj and mtl removed

	local status=0
	local file_export_blend="${name_model}.blend"

	frobulator.fwd "Optimizing..."

	frobulator.fwd "Output" "[ ${name_export} // ${file_export_blend} ]"

	blender									\
		--background						\
		--python		"${file_optimize}"	\
		--									\
											"${file_export}" > "${sink}" 2>&1 &

	frobulator.progress "optimize"

	frobulator.track || return "${status}"

	# blender exits without error when saving fails

	if [ ! -f "${file_export_blend}" ]
	then
		status=1

		return "${status}"
	fi

	rm --force "${file_export}" "${name_model}.mtl"

	file_export="${file_export_blend}"

	return "${status}"
}

l2cu_export_size () {

	# export file size in kilobytes - threshold 25 * 1024

	local status=0
	local threshold_size=25600
	local unit_size="kilobytes"

	local size_export

	size_export="$(du -k "${file_export}" | cut -f 1)"

	frobulator.track || return "${status}"

	if [ "${size_export}" -le "${threshold_size}" ]
	then
		frobulator.scs "File size" "[ ${unit_size} // ${size_export} ]"
	else
		frobulator.wrn "File size" "[ ${unit_size} // ${size_export} ]"

		frobulator.wrn "Model file size is above recommended threshold of ${threshold_size} ${unit_size}!"
		frobulator.nul "You may experience higher than average loading times."
	fi

	return "${status}"
}

