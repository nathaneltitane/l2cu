l2cu_pieces () {

	# total piece count written to model pieces file

	local status=0
	local file_csv_parts="${directory_model}/parts.csv"
	local file_pieces="${directory_model}/pieces"
	local count_pieces_total=0

	local count_pieces_part

	local -a list_fields_csv=()

	frobulator.inf "Generating pieces count file" "[ ${name_model} ]"

	leocad										\
		--export-csv	"${file_csv_parts}"	\
												"${path_model}" > "${sink}" 2>&1 &

	frobulator.progress "parse"

	frobulator.track || return "${status}"

	# quantity is the third field from the end - part names may contain commas - header skipped

	while IFS=',' read -r -a list_fields_csv
	do
		count_pieces_part="${list_fields_csv[-3]//\"/}"

		count_pieces_total=$(( count_pieces_total + count_pieces_part ))
