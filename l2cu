l2cu_model () {

	# model path elements - shared by all options

	local status=0

	model_path="${1}"
	model_file="${model_path##*/}"
	model_name="${model_file%.*}"
	model_directory="${model_path%/*}"

	return "${status}"
}

l2cu_export () {

	local status=0

	frobulator.inf "Exporting" "[ ${model_file} ]"

	frobulator.fwd "Output" "[ ${export_name} // ${export_file} ]"

	leocad											\
		-"${export_extension}"	"${export_file}" 	\
													"${model_path}" > "${sink}" 2>&1 &

	frobulator.progress "generate"

	frobulator.track || return "${status}"

	# collada transparency read as opaque by viewers

	if [ "${export_option}" = "collada" ]
	then
		sed																\
			-i															\
			-e		's/<transparent>/<transparent opaque="A_ONE">/g'	\
																		"${export_file}"

		frobulator.track
	fi

	return "${status}"
}

l2cu_optimize () {

	# import obj into blender - save optimized blend - obj and mtl removed

	local status=0
	local export_file_blend="${model_name}.blend"

	frobulator.fwd "Optimizing..."

	frobulator.fwd "Output" "[ ${export_name} // ${export_file_blend} ]"

	blender									\
		--background						\
		--python		"${file_optimize}"	\
		--									\
											"${export_file}" > "${sink}" 2>&1 &

	frobulator.progress "optimize"

	frobulator.track || return "${status}"

	# blender exits without error when saving fails

	if [ ! -f "${export_file_blend}" ]
	then
		status=1

		return "${status}"
	fi

	rm --force "${export_file}" "${model_name}.mtl"

	export_file="${export_file_blend}"

	return "${status}"
}

l2cu_export_size () {

	# export file size in kilobytes - threshold 25 * 1024

	local status=0
	local size_threshold=25600
	local size_unit="kilobytes"

	local export_size

	export_size="$(du -k "${export_file}" | cut -f 1)"

	frobulator.track || return "${status}"

	if [ "${export_size}" -le "${size_threshold}" ]
	then
		frobulator.scs "File size" "[ ${size_unit} // ${export_size} ]"
	else
		frobulator.wrn "File size" "[ ${size_unit} // ${export_size} ]"

		frobulator.wrn "Model file size is above recommended threshold of ${size_threshold} ${size_unit}!"
		frobulator.nul "You may experience higher than average loading times."
	fi

	return "${status}"
}

l2cu_render () {

	local status=0
	local coordinates="${1}"
	local antialias_samples=8
	local render_file="${model_name}-${view[coordinates]}.${export_extension}"

	frobulator.inf "Rendering" "[ ${model_name} ]"

	frobulator.fwd "Output" "[ view preset ${view[coordinates]} // ${render_file} ]"

	leocad																			\
		--height		"${height}"													\
		--width			"${width}"													\
		--camera-angles	"${latitude[coordinates]}" "${longitude[coordinates]}"		\
		--shading		"${shading}"												\
		--line-width	"${line_width}"												\
		--aa-samples	"${antialias_samples}"										\
		--image			"${render_file}"											\
																					"${model_path}" > "${sink}" 2>&1 &

	frobulator.progress "render"

	frobulator.track

	return "${status}"
}

l2cu_pieces () {

	# total piece count written to model pieces file

	local status=0
	local part_count_file="${model_directory}/parts.csv"
	local pieces_file="${model_directory}/pieces"
	local total_pieces=0

	local part_quantity

	local -a part_fields=()

	frobulator.inf "Generating pieces count file" "[ ${model_name} ]"

	leocad										\
		--export-csv	"${part_count_file}"	\
												"${model_path}" > "${sink}" 2>&1 &

	frobulator.progress "parse"

	frobulator.track || return "${status}"

	# quantity is the third field from the end - part names may contain commas - header skipped

	while IFS=',' read -r -a part_fields
	do
		part_quantity="${part_fields[-3]//\"/}"

		total_pieces=$(( total_pieces + part_quantity ))
	done < <(tail -n +2 "${part_count_file}")

	echo "${total_pieces}" > "${pieces_file}"

	frobulator.track

	rm --force "${part_count_file}"

	frobulator.stp "Pieces" "[ ${total_pieces} ]"

	return "${status}"
}

l2cu_instructions_clean () {

	# lpub3d configuration and cache files

	local status=0

	rm																		\
		--recursive															\
		--force																\
			"${instructions_directory}/configuration"						\
			"${instructions_model_path}"									\
			"${instructions_directory}"/[lL][pP][uU][bB][3][dD]

	frobulator.track

	return "${status}"
}

l2cu_instructions_prepare () {

	# fresh instructions directory

	local status=0

	frobulator.inf "Preparing instructions setup" "[ ${model_name} ]"

	cd "${model_directory}"

	frobulator.track || return "${status}"

	rm --recursive --force "${instructions_directory}"

	frobulator.directory "${model_directory}" instructions

	frobulator.track || return "${status}"

	frobulator.directory "${instructions_directory}" samples

	frobulator.track

	return "${status}"
}

l2cu_instructions_configure () {

	local status=0

	local configuration_file
	local configuration_title
	local configuration_pieces
	local configuration_url_category
	local configuration_url_name
	local line

	local -a configuration_files_list=(
		"${model_directory}/title"
		"${model_directory}/pieces"
		"${model_directory%/*}/title"
	)

	frobulator.inf "Configuring instructions" "[ ${model_name} ]"

	frobulator.inf "Validating configuration elements"

	for configuration_file in "${configuration_files_list[@]}"
	do
		if [ ! -f "${configuration_file}" ]
		then
			frobulator.err "Configuration element missing" "[ ${configuration_file} ]"

			status=1
		fi
	done

	if [ "${status}" -ne 0 ]
	then
		return "${status}"
	fi

	frobulator.fwd "Parsing..."

	# title on one line - line breaks removed

	configuration_title="$(< "${model_directory}/title")"
	configuration_title="${configuration_title//$'\n'/ }"
	configuration_title="${configuration_title//<\/br>/}"

	configuration_pieces="$(< "${model_directory}/pieces")"

	# category from parent directory title - url form

	configuration_url_category="$(< "${model_directory%/*}/title")"
	configuration_url_category="${configuration_url_category// /-}"

	configuration_url_name="${model_name^^}"

	# substitute configuration variables - write instructions configuration

	while IFS='' read -r line
	do
		line="${line//'${configuration_title_string}'/"${configuration_title}"}"
		line="${line//'${configuration_pieces}'/"${configuration_pieces}"}"
		line="${line//'${configuration_url_category}'/"${configuration_url_category}"}"
		line="${line//'${configuration_url_name}'/"${configuration_url_name}"}"

		echo "${line}"
	done < "${instructions_base_directory}/configuration" > "${instructions_directory}/configuration"

	frobulator.track || return "${status}"

	frobulator.fwd "Configuring..."

	# configuration from base instructions framework followed by model

	cat "${instructions_directory}/configuration" "${model_path}" > "${instructions_model_path}"

	frobulator.track

	return "${status}"
}

l2cu_instructions_samples_placeholders () {

	local status=0

	local sample_index

	frobulator.inf "Generating placeholders" "[ ${model_name} ]"

	for (( sample_index = 1; sample_index <= 6; sample_index++ ))
	do
		cp "${instructions_base_directory}/work-in-progress.png" "${instructions_samples_directory}/sample-0${sample_index}.png"

		frobulator.track
	done

	return "${status}"
}

l2cu_instructions_samples () {

	local status=0
	local renderer="native"
	local projection="perspective"
	local sample_number=1

	local step_count
	local sample_index
	local sample_range
	local sample_path

	local -a sample_pages=()
	local -a samples_list=()

	frobulator.inf "Generating instructions" "[ ${model_name} ]"

	# step count of the instructions model

	step_count="$(grep -c -E '^0 STEP' "${instructions_model_path}")"

	# six sample pages spread over the instructions - first page minimum

	sample_pages=(
		1
		$(( step_count / 5 - 2 ))
		$(( step_count / 4 - 3 ))
		$(( step_count / 3 - 4 ))
		$(( step_count / 2 - 5 ))
		"${step_count}"
	)

	for sample_index in "${!sample_pages[@]}"
	do
		if [ "${sample_pages[sample_index]}" -lt 1 ]
		then
			sample_pages[sample_index]=1
		fi
	done

	printf -v sample_range '%s,' "${sample_pages[@]}"

	sample_range="${sample_range%,}"

	frobulator.stp "Generating range" "[ ${sample_range} ]"

	"${lpub}"											\
		--clear-cache									\
		--preferred-renderer	"${renderer}"			\
		--projection			"${projection}"			\
		--process-export								\
		--export-option			"${export_extension}"	\
		--range					"${sample_range}"		\
														"${instructions_model_path}" > "${sink}" 2>&1 &

	frobulator.progress "generate"

	frobulator.track

	l2cu_instructions_clean

	# sample pages renamed in page order

	mapfile -t samples_list < <(find "${instructions_directory}" -type f -iname "*page*.${export_extension}" | sort -V)

	for sample_path in "${samples_list[@]}"
	do
		mv "${sample_path}" "${instructions_samples_directory}/sample-0${sample_number}.${export_extension}"

		frobulator.track

		sample_number=$(( sample_number + 1 ))
	done

	return "${status}"
}

l2cu_instructions () {

	local status=0
	local renderer="native"
	local projection="perspective"

	frobulator.inf "Generating instructions" "[ ${model_name} ]"

	"${lpub}"																\
		--clear-cache														\
		--preferred-renderer	"${renderer}"								\
		--projection			"${projection}"								\
		--process-export													\
		--export-option			"${export_extension}"						\
		--pdf-output-file		"${instructions_directory}/${model_name}.pdf"	\
																			"${instructions_model_path}" > "${sink}" 2>&1 &

	frobulator.progress "generate"

	frobulator.track

	l2cu_instructions_clean

	return "${status}"
}

l2cu_parse_input () {

	# read user input - empty input refused

	local status=0

	while true
	do
		frobulator.read input

		if [ -n "${input}" ]
		then
			break
		fi

		frobulator.ipt "Input cannot be empty - Try again."
	done

	return "${status}"
}

l2cu_help_colors () {

	local status=0

	frobulator.fwd "Displaying official colors selections..."

	frobulator.timeout

	frobulator.inf "Official LDraw colors" "[ name / number / hexadecimal ]"

	sed -e "s/^/${marker_idt}/g" -e "s/_/ /g" "${file_colors}"

	echo

	return "${status}"
}

l2cu_parse_colors () {

	# match input to an ldraw color - name / number / hexadecimal - lowercase

	local status=0

	local color_input
	local color_name
	local color_value
	local color_hex

	l2cu_parse_input

	color_input="${input,,}"
	color_input="${color_input#\#}"

	while read -r color_name color_value color_hex
	do
		color_name="${color_name//_/ }"
		color_hex="${color_hex#\#}"

		if [ "${color_input}" = "${color_name,,}" ] ||
		   [ "${color_input}" = "${color_value}" ] ||
		   [ "${color_input}" = "${color_hex,,}" ]
		then
			ldraw_color_value="${color_value}"

			frobulator.fwd "Confirming input..."

			frobulator.timeout

			frobulator.inf "Color name"              "[ ${color_name} ]"
			frobulator.inf "Color value"             "[ ${color_value} ]"
			frobulator.inf "Color hexadecimal value" "[ ${color_hex} ]"

			return "${status}"
		fi
	done < "${file_colors}"

	frobulator.err "No match for input" "[ ${input} ]"

	frobulator.timeout

	l2cu_help_colors

	frobulator.fwd "Exiting..."

	exit 1
}

l2cu_parse_modification () {

	# read modification request

	local status=0

	case "${modify_option}"
	in
		color)
			frobulator.ipt "Enter color to modify" "[ name / number / hexadecimal ]"

			l2cu_parse_colors

			old_color="${ldraw_color_value}"

			frobulator.ipt "Enter color to set" "[ name / number / hexadecimal ]"

			l2cu_parse_colors

			new_color="${ldraw_color_value}"
		;;

		part)
			frobulator.ipt "Enter part to modify" "[ number ]"

			l2cu_parse_input

			old_part="${input}"

			frobulator.ipt "Enter part to set" "[ number ]"

			l2cu_parse_input

			new_part="${input}"
		;;

		bind)
			frobulator.ipt "Enter part to modify" "[ number ]"

			l2cu_parse_input

			part_selection="${input}"

			frobulator.ipt "Enter part color to modify" "[ name / number / hexadecimal ]"

			l2cu_parse_colors

			old_color="${ldraw_color_value}"

			frobulator.ipt "Enter part color to set" "[ name / number / hexadecimal ]"

			l2cu_parse_colors

			new_color="${ldraw_color_value}"
		;;
	esac

	return "${status}"
}

l2cu_lint () {

	# standardize model file for parsing

	local status=0

	frobulator.fwd "Linting..."

	# substitute windows carriage return for unix newline
	# strip ' . . .' tails left by earlier l2cu versions
	# substitute lines containing empty parsing string
	# substitute multiple whitespace characters to single whitespace
	# substitute author tag to uppercase author tag

	# delete lines containing name meta
	# delete lines with lone line type
	# delete lines beginning with whitespace character
	# delete lines beginning with dot character
	# delete lines containing BACKGROUND meta
	# delete lines containing PIVOT meta
	# delete lines containing HIDDEN meta

	# strip '(' character from model entries
	# strip ')' character from model entries

	# delete empty lines

	sed										\
		-e 's/\r//g' 						\
		-e 's/\( \{1,\}\.\)\{1,\} *$//'		\
		-e 's/0 STEP .* *\./0 STEP/g'		\
		-e 's/  */ /g'						\
		-e 's/Author/AUTHOR/g'				\
		-e '/Name/d'						\
		-e '/^0 *$/d'						\
		-e '/^1\ $/d'						\
		-e '/^ /d'							\
		-e '/^\./d'							\
		-e '/BACKGROUND/d'					\
		-e '/PIVOT/d'						\
		-e '/HIDDEN/d'						\
		-e 's/(//g'							\
		-e 's/)//g'							\
		-e '/^$/d'							\
											"${model_path}" > "${model_buffer}"

	frobulator.track

	return "${status}"
}

l2cu_line_repair () {

	# ' . . .' tails left on meta lines by earlier l2cu versions removed
	# works on the caller's line - counted in the caller's lines_repaired

	local status=0
	local pattern_tail='^(0.*[^ ])( +\.)+ *$'

	local line_inner

	if [[ "${line}" != 0* ]]
	then
		return "${status}"
	fi

	line_inner="${line#*$'\r'}"

	if [ "${line_inner}" != "${line}" ] && [[ "${line_inner}" =~ ^[\ .]*$ ]]
	then
		line="${line%%$'\r'*}"

		lines_repaired=$(( lines_repaired + 1 ))

	elif [[ "${line}" =~ ${pattern_tail} ]]
	then
		line="${BASH_REMATCH[1]}"

		lines_repaired=$(( lines_repaired + 1 ))
	fi

	return "${status}"
}

l2cu_modify () {

	# modify part references - other lines kept as is
	# line ending set aside before parsing - fields never carry it

	local status=0
	local lines_repaired=0

	local line
	local line_ending
	local line_modified
	local flag
	local color
	local x
	local y
	local z
	local a
	local b
	local c
	local d
	local e
	local f
	local g
	local h
	local i
	local component
	local part

	: > "${model_buffer}"

	frobulator.track || return "${status}"

	# last line kept if it has no trailing newline

	while IFS='' read -r line || [ -n "${line}" ]
	do
		unset line_ending

		if [[ "${line}" = *$'\r' ]]
		then
			line_ending=$'\r'
			line="${line%$'\r'}"
		fi

		l2cu_line_repair

		read -r flag color x y z a b c d e f g h i component <<< "${line}"

		# part / submodel references only - line type 1 with all fields

		if [ "${flag}" != "1" ] || [ -z "${component}" ]
		then
			printf '%s%s\n' "${line}" "${line_ending}" >> "${model_buffer}"

			continue
		fi

		# component is either part or submodel - [number].dat / [name].ldr

		part="${component%.*}"

		unset line_modified

		case "${modify_option}"
		in
			color)
				if [ "${color}" = "${old_color}" ]
				then
					color="${new_color}"
					line_modified=true

					frobulator.inf "Modifying" "[ ${old_color} ]"
					frobulator.inf "Setting"   "[ ${new_color} ]"
				fi
			;;

			part)
				if [ "${part}" = "${old_part}" ]
				then
					component="${new_part}.${component##*.}"
					line_modified=true

					frobulator.inf "Modifying" "[ ${old_part} ]"
					frobulator.inf "Setting"   "[ ${new_part} ]"
				fi
			;;

			bind)
				if [ "${part}" = "${part_selection}" ] && [ "${color}" = "${old_color}" ]
				then
					color="${new_color}"
					line_modified=true

					frobulator.inf "Part"      "[ ${part} ]"

					frobulator.inf "Modifying" "[ ${old_color} ]"
					frobulator.inf "Setting"   "[ ${new_color} ]"
				fi
			;;
		esac

		if [ "${line_modified}" != "true" ]
		then
			printf '%s%s\n' "${line}" "${line_ending}" >> "${model_buffer}"

			continue
		fi

		# rebuilt line shares the original line ending

		printf '%s%s\n' "${flag} ${color} ${x} ${y} ${z} ${a} ${b} ${c} ${d} ${e} ${f} ${g} ${h} ${i} ${component}" "${line_ending}" >> "${model_buffer}"
	done < "${model_path}"

	frobulator.track

	if [ "${lines_repaired}" -gt 0 ]
	then
		frobulator.inf "Repaired meta lines" "[ ${lines_repaired} ]"
	fi

	return "${status}"
}

l2cu_step () {

	# each ldr submodel in its own step - a step is closed only if it holds parts
	# piece meta lines kept with their piece - empty steps removed
	# line ending set aside before parsing - fields never carry it

	local status=0
	local lines_repaired=0
	local steps_removed=0
	local step_content=false

	local line
	local line_ending
	local line_pending
	local step_added
	local flag
	local color
	local x
	local y
	local z
	local a
	local b
	local c
	local d
	local e
	local f
	local g
	local h
	local i
	local component

	local -a lines_pending=()

	: > "${model_buffer}"

	frobulator.track || return "${status}"

	# last line kept if it has no trailing newline

	while IFS='' read -r line || [ -n "${line}" ]
	do
		unset line_ending

		if [[ "${line}" = *$'\r' ]]
		then
			line_ending=$'\r'
			line="${line%$'\r'}"
		fi

		l2cu_line_repair

		# piece meta lines held until their piece

		if [[ "${line}" = "0 !LEOCAD PIECE "* ]]
		then
			lines_pending+=("${line}${line_ending}")

			continue
		fi

		# step closed only if it holds parts - step following an added step not counted

		if [ "${line}" = "0 STEP" ]
		then
			if [ "${step_content}" = "true" ]
			then
				printf '%s%s\n' "${line}" "${line_ending}" >> "${model_buffer}"

				step_content=false

			elif [ "${step_added}" != "true" ]
			then
				steps_removed=$(( steps_removed + 1 ))
			fi

			unset step_added

			continue
		fi

		unset step_added

		read -r flag color x y z a b c d e f g h i component <<< "${line}"

		# ldr submodel - previous step closed - own step

		if [ "${flag}" = "1" ] && [[ "${component}" = *.[lL][dD][rR] ]]
		then
			if [ "${step_content}" = "true" ]
			then
				printf '%s%s\n' "0 STEP" "${line_ending}" >> "${model_buffer}"
			fi

			for line_pending in "${lines_pending[@]}"
			do
				printf '%s\n' "${line_pending}" >> "${model_buffer}"
			done

			lines_pending=()

			# submodel color reset - applications use incompatible color schemes

			printf '%s%s\n' "${flag} 0 ${x} ${y} ${z} ${a} ${b} ${c} ${d} ${e} ${f} ${g} ${h} ${i} ${component}" "${line_ending}" >> "${model_buffer}"
			printf '%s%s\n' "0 STEP" "${line_ending}" >> "${model_buffer}"

			step_content=false
			step_added=true

			frobulator.inf "Stepping" "[ ${component} ]"

			continue
		fi

		for line_pending in "${lines_pending[@]}"
		do
			printf '%s\n' "${line_pending}" >> "${model_buffer}"
		done

		lines_pending=()

		printf '%s%s\n' "${line}" "${line_ending}" >> "${model_buffer}"

		# drawing lines fill the step - a new submodel starts empty

		case "${flag}"
		in
			1|2|3|4|5)
				step_content=true
			;;
		esac

		if [[ "${line}" = "0 FILE "* ]]
		then
			step_content=false
		fi
	done < "${model_path}"

	frobulator.track

	for line_pending in "${lines_pending[@]}"
	do
		printf '%s\n' "${line_pending}" >> "${model_buffer}"
	done

	if [ "${lines_repaired}" -gt 0 ]
	then
		frobulator.inf "Repaired meta lines" "[ ${lines_repaired} ]"
	fi

	if [ "${steps_removed}" -gt 0 ]
	then
		frobulator.inf "Removed empty steps" "[ ${steps_removed} ]"
	fi

	return "${status}"
}

l2cu_write () {

	# modified model file - original overwritten or timestamped copy

	local status=0
	local model_copy="${model_directory}/${model_name}-modified-${stamp}.${extension}"

	if [ "${overwrite_option}" = "overwrite" ]
	then
		frobulator.wrn "Writing to model file original" "[ ${model_file} ]"

		frobulator.timeout

		mv "${model_buffer}" "${model_path}"
	else
		frobulator.wrn "Writing to model file copy" "[ ${model_copy##*/} ]"

		frobulator.fwd "Writing..."

		mv "${model_buffer}" "${model_copy}"
	fi

	frobulator.track

	return "${status}"
}

l2cu_download () {

	# ldraw parts library archive

	local status=0

	frobulator.download "${url_library}/${library_release}" "${directory}" "${library_archive}"

	frobulator.track || return "${status}"

	# leocad reads the parts archive without extraction - official archive renamed

	if [ "${download_option}" = "official" ]
	then
		mv 											\
			"${directory}/${library_archive}"		\
			"${directory}/ldraw.zip"

		frobulator.track
	fi

	return "${status}"
}

l2cu_list () {

	# ldraw parts list entries - moved parts skipped - '_' and '~' descriptions listed last

	local status=0

	local extension
	local part_path
	local part_file
	local part_file_header
	local part_file_description

	local -a parts_list=()

	for extension in "${extensions_list[@]}"
	do
		mapfile -t parts_list < <(find "${directory}" -type f -iname "*.${extension}")

		for part_path in "${parts_list[@]}"
		do
			part_file="${part_path##*/}"

			read -r part_file_header < "${part_path}"

			part_file_description="${part_file_header:2}"
			part_file_description="${part_file_description%$'\r'}"

			if [[ "${part_file_description}" == *~Moved* ]]
			then
				continue
			fi

			if [[ "${part_file_description}" == *_* ]]
			then
				printf '%-30s %-s\n' "${part_file}" "${part_file_description}" >> "._.lst"

			elif [[ "${part_file_description}" == *~* ]]
			then
				printf '%-30s %-s\n' "${part_file}" "${part_file_description}" >> ".~.lst"
			else
				printf '%-30s %-s\n' "${part_file}" "${part_file_description}" >> parts.lst
			fi
		done
	done

	return "${status}"
}

